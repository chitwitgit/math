{
  "name": "@chitwitgit/m2d-math",
  "author": "Mayank Kumar Chaudhari (https://mayank-chaudhari.vercel.app)",
  "contributors": [
    "chitwitgit (https://github.com/chitwitgit)"
  ],
  "private": false,
  "version": "0.1.3",
  "description": "Fork of @m2d/math with expanded LaTeX→OMML macro coverage for DOCX export. Plugin to convert mathematical expressions in Markdown (MDAST) to DOCX using LaTeX-style syntax.",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chitwitgit/math.git",
    "directory": "lib"
  },
  "bugs": "https://github.com/chitwitgit/math/issues",
  "homepage": "https://github.com/chitwitgit/math/tree/chore/npm-publish/lib#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig-build.json && rm -f dist/katexData.d.ts && gzip -c dist/index.js | wc -c",
    "clean": "rm -rf dist",
    "dev": "tsup --watch && tsc -p tsconfig-build.json -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run --coverage",
    "generate:katex": "node --experimental-strip-types scripts/generate-katex-data.ts",
    "prepack": "cp ../LICENSE ./LICENSE"
  },
  "devDependencies": {
    "@xarsh/ooxml-validator": "^0.3.0",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "docx": "^9.7.1",
    "esbuild-plugin-rdi": "^0.0.0",
    "jsdom": "^29.1.1",
    "remark-parse": "^11.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@m2d/core": "^1.7.1",
    "latex-math": "^0.0.2"
  },
  "peerDependencies": {
    "docx": "^9.3.0",
    "remark-math": "^6.0.0"
  },
  "keywords": [
    "math",
    "latex",
    "math expressions",
    "math plugin",
    "markdown-to-docx",
    "mdast2docx",
    "markdown",
    "mdast",
    "docx",
    "ms-word",
    "omml",
    "text-processing",
    "export",
    "document generator",
    "typescript",
    "remark",
    "unified"
  ]
}